{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "pub": {
      ".indexOn": ["t"],
      ".read": "auth != null",
      "$code": { ".write": "auth != null" }
    },
    "live": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "ev": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "chat": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "app": {
      ".read": true,
      ".write": false
    }
  }
}
